# Copy to .env, set your database password and a random JWT_SECRET. Never commit .env.
APP_ENV=development
DATABASE_URL=mysql+pymysql://carecircle:CHANGE_ME@127.0.0.1:3306/carecircle?charset=utf8mb4
APP_ORIGIN=http://localhost:5173
JWT_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET
JWT_ISSUER=carecircle
JWT_AUDIENCE=carecircle-web
COOKIE_SECURE=false
PRIVATE_STORAGE_PATH=./private_storage
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=carecircle@example.test
